---
import { t } from "../i18n/index";

interface Props {
  lang: string;
}
const { lang = "zh" } = Astro.props;

const badges = [
  { key: "trust.founded", icon: "🏛️" },
  { key: "trust.ossC", icon: "🌐" },
  { key: "trust.asme", icon: "🛡️" },
  { key: "trust.patents", icon: "🔬" },
];
---

<ul class="trust-badges flex flex-wrap gap-3" aria-label={lang === "zh" ? "信任角标" : "Trust badges"}>
  {badges.map((b) => (
    <li class="trust-badge list-none m-0 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-4 py-2 text-xs font-semibold text-white backdrop-blur">
      <span aria-hidden="true">{b.icon}</span>
      {t(lang, b.key)}
    </li>
  ))}
</ul>

<style>
  .trust-badges {
    margin-top: 1rem;
  }
</style>
