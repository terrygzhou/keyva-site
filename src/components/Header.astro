---
/** Site navigation. Mobile menu is a zero-JS <details> pattern (no island
 *  needed) — keeps the a11y story simple and works without JS. */
const nav = [
  { href: "/services/", label: "Services" },
  { href: "/case-studies/", label: "Case Studies" },
  { href: "/insights/", label: "Insights" },
  { href: "/about/", label: "About" },
];
---

<header class="border-b border-neutral-200 bg-white">
  <nav aria-label="Primary" class="container-site flex items-center justify-between py-4">
    <a href="/" class="font-display text-2xl font-bold text-brand-primary">
      KeyVA
    </a>

    <!-- Mobile toggle -->
    <details class="md:hidden">
      <summary class="list-none cursor-pointer rounded-md p-2 text-brand-primary" aria-label="Menu">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </summary>
      <div class="absolute left-4 right-4 top-14 rounded-lg border border-neutral-200 bg-white p-4 shadow-lg">
        <ul class="flex flex-col gap-2">
          {nav.map((item) => (
            <li>
              <a href={item.href} class="block rounded-md px-3 py-2 font-medium text-neutral-700 hover:bg-neutral-100">
                {item.label}
              </a>
            </li>
          ))}
          <li>
            <a href="/contact/" class="btn-primary block text-center">Get in touch</a>
          </li>
        </ul>
      </div>
    </details>

    <!-- Desktop nav -->
    <ul class="hidden items-center gap-6 md:flex">
      {nav.map((item) => (
        <li>
          <a href={item.href} class="font-medium text-neutral-600 hover:text-brand-primary">
            {item.label}
          </a>
        </li>
      ))}
    </ul>
    <a href="/contact/" class="btn-primary hidden md:inline-flex">Get in touch</a>
  </nav>
</header>
