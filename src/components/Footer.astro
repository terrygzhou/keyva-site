---
import { t, localPath } from "../i18n/index";
import CertLogos from "./CertLogos.astro";

interface Props {
  lang: string;
}

const { lang = "zh" } = Astro.props;
const isZh = lang === "zh";

// Single source of truth: both locales are URL-prefixed (/zh/... and /en/...).
function linkFor(core: string) {
  return localPath(lang, core);
}

const year = new Date().getFullYear();
const contact = {
  address: isZh
    ? "上海市松江区申港路 3255 号金地威新智造园 7 栋 1 层"
    : "1F, Bldg 7, Jindi Weixing Smart Park, 3255 Shengang Rd, Songjiang, Shanghai",
  email: "info@keyva.cn",
  phonePower: isZh ? "电力咨询：021-50896336" : "Power: 021-50896336",
  phoneChem: isZh ? "石化/矿山：021-50898122" : "Petrochemical / Mining: 021-50898122",
};
---

<footer class="bg-neutral-900 text-neutral-300">
  <div class="container-site py-10">
    <div class="grid gap-8 md:grid-cols-3">
      <div>
        <img
          src="/images/brand/keyva-logo-white.png"
          alt="KEYVA"
          width="649"
          height="183"
          class="h-9 w-auto"
          loading="lazy"
        />
        <p class="mt-3 text-sm leading-relaxed text-neutral-400">
          {isZh
            ? "专业高端金属密封球阀制造商，专注电力、石化、矿山苛刻工况阀门解决方案。"
            : "Specialist manufacturer of high-end metal-seated ball valves for power, petrochemical, and mining critical-service applications."}
        </p>
      </div>
      <nav aria-label="Footer">
        <p class="text-sm font-semibold uppercase tracking-wider text-neutral-500">{t(lang, "footer.quickLinks")}</p>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href={linkFor("/about/")} class="hover:text-white hover:underline">{t(lang, "nav.about")}</a></li>
          <li><a href={linkFor("/products/")} class="hover:text-white hover:underline">{t(lang, "nav.products")}</a></li>
          <li><a href={linkFor("/case-studies/")} class="hover:text-white hover:underline">{t(lang, "nav.caseStudies")}</a></li>
          <li><a href={linkFor("/contact/")} class="hover:text-white hover:underline">{t(lang, "nav.contact")}</a></li>
        </ul>
      </nav>
      <div>
        <p class="text-sm font-semibold uppercase tracking-wider text-neutral-500">{t(lang, "footer.contactLabel")}</p>
        <ul class="mt-3 space-y-2 text-sm">
          <li>{contact.address}</li>
          <li><a href={`mailto:${contact.email}`} class="hover:text-white hover:underline">{contact.email}</a></li>
          <li>{contact.phonePower}</li>
          <li>{contact.phoneChem}</li>
        </ul>
        <p class="mt-4 text-xs text-neutral-600">沪ICP备2025153087号-1</p>
      </div>
    </div>
    <div class="mt-10 flex flex-col gap-5 border-t border-neutral-800 pt-6 sm:flex-row sm:items-center sm:justify-between">
      <CertLogos lang={lang} tone="dark" size="sm" showLabels={false} />
      <p class="text-xs text-neutral-500">
        &copy; {year} KEYVA. {isZh ? "保留所有权利。" : "All rights reserved."}
      </p>
    </div>
  </div>
</footer>
