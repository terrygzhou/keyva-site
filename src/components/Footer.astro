---
const year = new Date().getFullYear();
const contact = {
  email: "info@keyvatech.com", // TODO: confirm the live enquiry address
  linkedin: "https://www.linkedin.com/company/keyvatech",
};
---

<footer class="bg-neutral-900 text-neutral-300">
  <div class="container-site py-10">
    <div class="grid gap-8 md:grid-cols-3">
      <div>
        <p class="font-display text-xl font-bold text-white">KeyVA</p>
        <p class="mt-3 text-sm leading-relaxed text-neutral-400">
          IT automation and business transformation consulting.
        </p>
      </div>
      <nav aria-label="Footer">
        <p class="text-sm font-semibold uppercase tracking-wider text-neutral-500">Navigate</p>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href="/services/" class="hover:text-white hover:underline">Services</a></li>
          <li><a href="/case-studies/" class="hover:text-white hover:underline">Case Studies</a></li>
          <li><a href="/insights/" class="hover:text-white hover:underline">Insights</a></li>
          <li><a href="/contact/" class="hover:text-white hover:underline">Contact</a></li>
        </ul>
      </nav>
      <div>
        <p class="text-sm font-semibold uppercase tracking-wider text-neutral-500">Contact</p>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href={`mailto:${contact.email}`} class="hover:text-white hover:underline">{contact.email}</a></li>
          <li>
            <a href={contact.linkedin} rel="noopener" class="hover:text-white hover:underline">
              LinkedIn
            </a>
          </li>
        </ul>
      </div>
    </div>
    <p class="mt-10 border-t border-neutral-800 pt-6 text-xs text-neutral-500">
      &copy; {year} KeyVA. All rights reserved.
    </p>
  </div>
</footer>
