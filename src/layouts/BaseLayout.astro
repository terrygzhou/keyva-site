---
import "../assets/styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "KeyVA — IT Consulting & Business Transformation",
  description = "KeyVA — IT consulting and business transformation. Take the pain out of complexity and ship transformation that lasts.",
  ogImage = "/og-default.jpg",
} = Astro.props;

const site = {
  name: "KeyVA",
  url: "https://www.keyvatech.com",
  orgJsonLd: JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "KeyVA",
    url: "https://www.keyvatech.com",
    description: "IT consulting and business transformation.",
    sameAs: ["https://www.linkedin.com/company/keyvatech"],
  }),
};

const fullTitle = title === site.name ? site.name : `${title} | ${site.name}`;
const canonical = `${site.url}${Astro.url.pathname === "/" ? "" : Astro.url.pathname}`;

// Analytics: enabled on the production host only (same guard pattern as
// eywalink-site). Replace the Umami website id when the KeyVA property is
// created; until then nothing is tracked and the site still works.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Twitter -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.url}${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="627" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Structured data -->
    <script is:inline type="application/ld+json">{site.orgJsonLd}</script>

    <!-- Analytics (guarded to production host; see BaseLayout note) -->
    <script is:inline>
      if (["keyvatech.com", "www.keyvatech.com"].includes(window.location.hostname)) {
        window.dataLayer = window.dataLayer || [];
        // TODO: drop in the KeyVA analytics snippet (Umami/Matomo) once the
        // property exists; keep this guard so dev/preview hosts stay silent.
      }
    </script>
  </head>
  <body class="min-h-screen font-sans">
    <!-- a11y: skip link is the first focusable element -->
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
