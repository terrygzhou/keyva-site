---
import "../assets/styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Explicit locale for `[lang]` pages; falls back to middleware-set locals. */
  lang?: string;
}

const {
  title = "KEYVA — 关键阀门 核心价值",
  description =
    "KEYVA — 高端金属密封球阀制造商。在最严苛的工况下，比同行多撑 3–5 年。电力、石化、矿山关键阀门解决方案。",
  ogImage = "/og-default.jpg",
  lang: langProp,
} = Astro.props;

// eslint-disable-next-line @typescript-eslint/no-explicit-any
const locale: string = langProp ?? ((Astro.locals as any).lang ?? "zh");
const site = {
  name: "KEYVA",
  url: "https://www.keyva.cn",
  orgJsonLd: JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "KEYVA",
    legalName: "KEYVA Control Inc.",
    url: "https://www.keyva.cn",
    description:
      locale === "zh"
        ? "KEYVA 是专业的高端金属密封球阀制造商，专注电力、石化、矿山苛刻工况阀门解决方案。"
        : "KEYVA is a specialist manufacturer of high-end metal-seated ball valves for power, petrochemical, and mining critical-service applications.",
    foundingDate: "1992",
    sameAs: [],
  }),
};

const fullTitle = title === site.name ? site.name : `${title} | ${site.name}`;
const canonical = `${site.url}${Astro.url.pathname === "/" ? "" : Astro.url.pathname}`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Twitter -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.url}${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="627" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Structured data -->
    <script is:inline type="application/ld+json">{site.orgJsonLd}</script>

    <!-- Analytics (production host guard) -->
    <script is:inline>
      if (["keyva.cn", "www.keyva.cn"].includes(window.location.hostname)) {
        window.dataLayer = window.dataLayer || [];
      }
    </script>
  </head>
  <body class="min-h-screen font-sans">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header lang={locale} />
    <main id="main-content">
      <slot />
    </main>
    <Footer lang={locale} />
  </body>
</html>
