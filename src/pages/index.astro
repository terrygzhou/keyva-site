---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const services = (await getCollection("services")).filter((s) => !s.data.draft);
const latestStudy = (await getCollection("case-studies"))
  .filter((c) => !c.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];
---

<BaseLayout>
  <!-- Hero -->
  <section class="bg-brand-primary py-24 text-white">
    <div class="container-site">
      <p class="text-sm font-semibold uppercase tracking-widest text-brand-highlight">
        IT Consulting · Business Transformation
      </p>
      <h1 class="mt-4 max-w-3xl font-display text-4xl font-bold leading-tight sm:text-5xl">
        Take the pain out of transformation
      </h1>
      <p class="mt-6 max-w-prose text-lg text-neutral-300">
        KeyVA helps organisations standardise on code-driven infrastructure,
        automate the busywork, and stay focused on the business.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a href="/contact/" class="btn-primary">Start a conversation</a>
        <a href="/services/" class="btn-outline border-white/30 text-white hover:bg-white hover:text-brand-primary">
          Explore services
        </a>
      </div>
    </div>
  </section>

  <!-- Services preview -->
  <section class="py-16" aria-labelledby="services-heading">
    <div class="container-site">
      <h2 id="services-heading" class="font-display text-3xl font-bold text-brand-primary">What we do</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {services.map((s) => (
          <a href={`/services/${s.slug}/`} class="rounded-xl border border-neutral-200 bg-white p-6 shadow-sm transition hover:shadow-md">
            <h3 class="font-display text-lg font-semibold text-brand-primary">{s.data.title}</h3>
            <p class="mt-2 text-sm text-neutral-600">{s.data.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Latest case study -->
  {latestStudy && (
    <section class="bg-neutral-100 py-16" aria-labelledby="latest-heading">
      <div class="container-site">
        <h2 id="latest-heading" class="font-display text-3xl font-bold text-brand-primary">Recent work</h2>
        <div class="mt-8 rounded-xl border border-neutral-200 bg-white p-8 shadow-sm">
          <p class="text-sm font-semibold uppercase tracking-wider text-brand-accent">
            {latestStudy.data.industry} · Case study
          </p>
          <h3 class="mt-2 font-display text-2xl font-semibold text-brand-primary">{latestStudy.data.title}</h3>
          <p class="mt-3 text-neutral-600">{latestStudy.data.summary}</p>
          <a href={`/case-studies/${latestStudy.slug}/`} class="mt-4 inline-block font-semibold text-brand-accent hover:underline">
            Read the case study →
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="py-16">
    <div class="container-site text-center">
      <h2 class="font-display text-3xl font-bold text-brand-primary">Ready when you are</h2>
      <p class="mx-auto mt-4 max-w-prose text-neutral-600">
        Tell us where it hurts. We'll map the path out of it.
      </p>
      <a href="/contact/" class="btn-primary mt-8">Get in touch</a>
    </div>
  </section>
</BaseLayout>
