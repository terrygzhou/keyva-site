---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About" description="KeyVA is an IT consulting and business transformation practice focused on durable, code-driven outcomes.">
  <section class="py-16">
    <div class="container-site max-w-3xl">
      <h1 class="font-display text-4xl font-bold text-brand-primary">About KeyVA</h1>

      <div class="prose mt-6 space-y-4 text-neutral-700">
        <p>
          KeyVA helps organisations navigate complexity and take the pain out of
          transformation, so teams can stay focused on the business and deliver
          lasting value.
        </p>
        <p>
          We establish patterns that make code-driven infrastructure the
          default — with security baked in from the start — and we pair that
          with the operating-model work that makes new capability actually stick.
        </p>
        <p>
          Practical, senior, and opinionated about what works. We'd rather earn
          your trust with one well-run programme than pitch you on five.
        </p>
      </div>

      <div class="mt-12 rounded-xl bg-neutral-100 p-8">
        <h2 class="text-xl font-semibold text-brand-primary">Work with us</h2>
        <p class="mt-2 text-neutral-600">
          Engagement models range from a two-week diagnostic to multi-quarter transformation programmes.
        </p>
        <a href="/contact/" class="btn-primary mt-4">Start a conversation</a>
      </div>
    </div>
  </section>
</BaseLayout>
