---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const services = await getCollection("services");
  return services.map((s) => ({ params: { slug: s.slug } }));
}
const { slug } = Astro.params;
const service = (await getCollection("services")).find((s) => s.slug === slug);

if (!service) {
  // Unreachable: every generated path comes from the collection.
  throw new Error(`Unknown service slug: ${slug}`);
}
---

<BaseLayout title={service.data.title} description={service.data.description}>
  <article class="py-16">
    <div class="container-site">
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-accent">Service</p>
      <h1 class="mt-2 font-display text-4xl font-bold text-brand-primary">{service.data.title}</h1>
      <p class="mt-6 max-w-prose text-lg text-neutral-600">{service.data.pitch}</p>

      <h2 class="mt-10 text-xl font-semibold text-brand-primary">What we do</h2>
      <ul class="mt-4 space-y-2 text-neutral-700">
        {service.data.capabilities.map((c) => (
          <li class="flex items-start gap-2">
            <span aria-hidden="true" class="mt-1 h-2 w-2 rounded-full bg-brand-accent" /> {c}
          </li>
        ))}
      </ul>

      {service.data.outcomes.length > 0 && (
        <>
          <h2 class="mt-10 text-xl font-semibold text-brand-primary">Outcomes</h2>
          <ul class="mt-4 space-y-2 text-neutral-700">
            {service.data.outcomes.map((o) => (
              <li class="flex items-start gap-2">
                <span aria-hidden="true" class="mt-1 h-2 w-2 rounded-full bg-brand-accent" /> {o}
              </li>
            ))}
          </ul>
        </>
      )}

      <div class="mt-12 rounded-xl bg-neutral-100 p-8">
        <h2 class="text-xl font-semibold text-brand-primary">Talk to us about {service.data.title}</h2>
        <a href="/contact/" class="btn-primary mt-4">Get in touch</a>
      </div>
    </div>
  </article>
</BaseLayout>
