---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const services = (await getCollection("services")).filter((s) => !s.data.draft);
---

<BaseLayout title="Services" description="IT automation, cloud and business transformation services from KeyVA.">
  <section class="py-16">
    <div class="container-site">
      <h1 class="font-display text-4xl font-bold text-brand-primary">Services</h1>
      <p class="mt-4 max-w-prose text-lg text-neutral-600">
        Practical consulting that takes the pain out of transformation.
      </p>

      <div class="mt-12 grid gap-8 md:grid-cols-2">
        {services.map((s) => (
          <article class="rounded-xl border border-neutral-200 bg-white p-8 shadow-sm">
            <h2 class="font-display text-xl font-semibold text-brand-primary">
              <a href={`/services/${s.slug}/`} class="hover:text-brand-accent">{s.data.title}</a>
            </h2>
            <p class="mt-3 text-neutral-600">{s.data.pitch}</p>
            <ul class="mt-4 space-y-1 text-sm text-neutral-500">
              {s.data.capabilities.map((c) => (
                <li>&mdash; {c}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
