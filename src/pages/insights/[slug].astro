---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("insights");
  return posts.map((p) => ({ params: { slug: p.slug } }));
}
const { slug } = Astro.params;
const post = (await getCollection("insights")).find((p) => p.slug === slug);

if (!post) {
  // Unreachable: every generated path comes from the collection.
  throw new Error(`Unknown insight slug: ${slug}`);
}
const { Content } = await post.render();
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="py-16">
    <div class="container-site max-w-prose">
      <p class="text-sm text-neutral-400">
        <time datetime={post.data.date.toISOString()}>{post.data.date.toDateString()}</time> · {post.data.author}
      </p>
      <h1 class="mt-2 font-display text-3xl font-bold text-brand-primary">{post.data.title}</h1>
      <div class="prose mt-6">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
