---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("insights"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Insights" description="Thinking on infrastructure, automation and transformation from KeyVA.">
  <section class="py-16">
    <div class="container-site">
      <h1 class="font-display text-4xl font-bold text-brand-primary">Insights</h1>
      <p class="mt-4 max-w-prose text-lg text-neutral-600">
        Ideas from the delivery floor — written for the people who have to make it work.
      </p>

      <div class="mt-12 grid gap-8 md:grid-cols-2">
        {posts.map((p) => (
          <article class="rounded-xl border border-neutral-200 bg-white p-8 shadow-sm">
            <p class="text-sm text-neutral-400">
              <time datetime={p.data.date.toISOString()}>{p.data.date.toDateString()}</time>
            </p>
            <h2 class="mt-2 font-display text-xl font-semibold text-brand-primary">
              <a href={`/insights/${p.slug}/`} class="hover:text-brand-accent">{p.data.title}</a>
            </h2>
            <p class="mt-3 text-neutral-600">{p.data.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
