---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { t, localPath, getLangPaths } from "../../../i18n/index";
import { getCollection, render } from "astro:content";

// Cartesian fan-out: every configured locale × every product slug.
export const getStaticPaths = async () => {
  const products = await getCollection("products");
  return getLangPaths().flatMap(({ lang }) =>
    products.map((p) => ({ params: { lang, slug: p.slug } }))
  );
};

const { lang, slug } = Astro.params;
const isZh = lang === "zh";

const products = await getCollection("products");
const product = products.find((p) => p.slug === slug);

if (!product) {
  throw new Response("Product not found", { status: 404 });
}

// Render the optional markdown body (if any) into HTML for the spec sheet.
const { Content } = await render(product);
const hasBody = product.body?.trim().length > 0;
---

<BaseLayout lang={lang}
  title={isZh ? `${product.data.nameZh} — ${product.data.series}` : `${product.data.nameEn} · ${product.data.series}`}
  description={isZh ? product.data.descZh : product.data.descEn}>
  <section class="bg-neutral-100 py-14">
    <div class="container-site">
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-accent">{product.data.series}</p>
      <h1 class="mt-2 font-display text-3xl font-extrabold text-brand-primary sm:text-4xl">
        {isZh ? product.data.nameZh : product.data.nameEn}
      </h1>
      <p class="mt-4 max-w-3xl text-lg leading-relaxed text-neutral-600">
        {isZh ? product.data.descZh : product.data.descEn}
      </p>
      {product.data.asmeCertified && (
        <span class="mt-4 inline-block rounded-full bg-brand-primary px-4 py-1.5 text-sm font-semibold text-white">
          {isZh ? "ASME 认证（2026）" : "ASME certified (2026)"}
        </span>
      )}
      <div class="mt-8 flex flex-wrap gap-4">
        <a href={localPath(lang, "/contact/")} class="btn-primary">{t(lang, "products.inquiry")}</a>
        <a href={localPath(lang, "/products/")} class="btn-outline">
          {isZh ? "查看全部产品" : "All products"}
        </a>
      </div>
    </div>
  </section>

  <section class="py-14">
    <div class="container-site grid gap-10 lg:grid-cols-[1fr_1.3fr]">
      <!-- Spec sheet -->
      <div>
        <h2 class="font-display text-2xl font-bold text-brand-primary">{isZh ? "规格" : "Specifications"}</h2>
        <dl class="mt-6 space-y-4 text-sm">
          <div class="rounded-lg border border-neutral-200 bg-white p-4">
            <dt class="font-semibold text-neutral-500">{isZh ? "口径 / 压力等级" : "Size / pressure class"}</dt>
            <dd class="mt-1 text-neutral-800">{product.data.size}</dd>
          </div>
          <div class="rounded-lg border border-neutral-200 bg-white p-4">
            <dt class="font-semibold text-neutral-500">{isZh ? "材料" : "Materials"}</dt>
            <dd class="mt-2 flex flex-wrap gap-2">
              {product.data.materials.map((m) => (
                <span class="rounded-full bg-neutral-100 px-3 py-1 font-mono text-xs text-neutral-700">{m}</span>
              ))}
            </dd>
          </div>
          <div class="rounded-lg border border-neutral-200 bg-white p-4">
            <dt class="font-semibold text-neutral-500">{isZh ? "连接方式" : "Connection"}</dt>
            <dd class="mt-1 text-neutral-800">{product.data.connection}</dd>
          </div>
        </dl>
      </div>

      <!-- Features + applications -->
      <div class="grid gap-8 sm:grid-cols-2">
        <div>
          <h3 class="font-display text-lg font-bold text-brand-primary">{isZh ? "技术特点" : "Technical features"}</h3>
          <ul class="mt-4 space-y-2 text-sm text-neutral-700">
            {(isZh ? product.data.featuresZh : product.data.featuresEn).map((f) => (
              <li class="flex gap-2">
                <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-accent"></span>
                {f}
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="font-display text-lg font-bold text-brand-primary">{isZh ? "应用场景" : "Applications"}</h3>
          <ul class="mt-4 space-y-2 text-sm text-neutral-700">
            {(isZh ? product.data.appsZh : product.data.appsEn).map((a) => (
              <li class="flex gap-2">
                <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-accent"></span>
                {a}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    {hasBody && (
      <div class="container-site mt-12">
        <div class="prose max-w-3xl text-neutral-700">
          <Content />
        </div>
      </div>
    )}
  </section>

  <section class="bg-neutral-100 py-14 text-center">
    <div class="container-site">
      <h2 class="font-display text-2xl font-bold text-brand-primary">
        {isZh ? "需要此产品的报价？" : "Need a quote for this product?"}
      </h2>
      <a href={localPath(lang, "/contact/")} class="btn-primary mt-6">{t(lang, "nav.inquiry")}</a>
    </div>
  </section>
</BaseLayout>
