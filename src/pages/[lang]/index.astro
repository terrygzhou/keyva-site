---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TrustBadges from "../../components/TrustBadges.astro";
import CertLogos from "../../components/CertLogos.astro";
import { t, localPath, getLangPaths } from "../../i18n/index";
import { getCollection } from "astro:content";

// Manual [lang] routes: fan out one entry per configured locale so both /zh/
// and /en/ are built. Astro.params.lang carries the active locale.
export const getStaticPaths = () =>
  getLangPaths().map(({ lang }) => ({ params: { lang } }));

const { lang } = Astro.params;
const isZh = lang === "zh";

const products = await getCollection("products");

// Photographs from www.keyva.cn `pic/` — the three field settings KEYVA
// serves: power generation, refining/petrochemical, precision manufacturing.
const fieldImages = [
  {
    src: "/images/hero/power-plant.webp",
    width: 1600,
    height: 1071,
    title: isZh ? "电力 · 锅炉与汽机" : "Power · boiler & turbine",
    caption: isZh ? "疏水、排汽与锅炉 PCV 关键工况" : "Drain, vent and boiler PCV critical service",
  },
  {
    src: "/images/hero/refinery-night.webp",
    width: 1600,
    height: 1064,
    title: isZh ? "石化 · SZorb 装置" : "Petrochemical · SZorb",
    caption: isZh ? "中石化 SZorb 装置阀门框架品牌" : "Framework valve brand for Sinopec SZorb",
  },
  {
    src: "/images/hero/keyva-balls.webp",
    width: 1000,
    height: 1499,
    title: isZh ? "制造 · 金属密封球体" : "Manufacturing · metal-seated balls",
    caption: isZh ? "热融合喷涂 + 纳米喷涂阀内件" : "Thermal-fusion + nano-sprayed internals",
  },
];

const clientLogos = [
  "中石化 Sinopec",
  "华能 Huaneng",
  "国能 State Energy",
  "京能 Capital Energy",
  "大唐 Datang",
  "华电 Huadian",
  "国电 GD Power",
  "华润 CR Power",
  "粤电 Yuedian",
  "金川 Jinchuan",
];
---

<BaseLayout lang={lang}
  title={isZh ? "KEYVA — 关键阀门 核心价值" : "KEYVA — Key Valve, Key Value"}
  description={
    isZh
      ? "KEYVA — 高端金属密封球阀制造商。在最严苛的工况下，比同行多撑 3–5 年。"
      : "KEYVA — high-end metal-seated ball valves that outlast competitors by 3–5 years in the harshest service."
  }>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-brand-primary py-24 text-white">
    <div
      class="pointer-events-none absolute inset-0 opacity-20"
      style="background: radial-gradient(1200px 500px at 80% -10%, #3DA5DD 0%, transparent 60%);"
      aria-hidden="true"></div>
    <div class="container-site relative">
      <p class="text-sm font-semibold uppercase tracking-widest text-brand-highlight">
        {t(lang, "hero.badge")}
      </p>
      <h1 class="mt-5 max-w-3xl font-display text-4xl font-extrabold leading-tight sm:text-5xl lg:text-6xl">
        {t(lang, "hero.title")}
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-neutral-200">
        {t(lang, "hero.subtitle")}
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a href={localPath(lang, "/contact/")} class="btn-primary">{t(lang, "hero.ctaPrimary")}</a>
        <a href={localPath(lang, "/products/")} class="btn-outline border-white/30 text-white hover:bg-white hover:text-brand-primary">
          {t(lang, "hero.ctaSecondary")}
        </a>
      </div>
      <TrustBadges lang={lang} />
    </div>
  </section>

  <!-- Field photography strip -->
  <section class="bg-neutral-100 py-12" aria-label={isZh ? "关键工况现场" : "Critical-service field settings"}>
    <div class="container-site grid gap-4 sm:grid-cols-3">
      {fieldImages.map((img) => (
        <figure class="group relative overflow-hidden rounded-xl bg-neutral-200">
          <img
            src={img.src}
            alt={img.title}
            width={img.width}
            height={img.height}
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:scale-105"
          />
          <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-neutral-950/90 via-neutral-950/35 to-transparent p-4 pt-12 text-white">
            <p class="font-display text-sm font-semibold">{img.title}</p>
            <p class="mt-0.5 text-xs text-neutral-200">{img.caption}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- Durability value module -->
  <section class="py-16" aria-labelledby="durability-heading">
    <div class="container-site grid items-center gap-10 lg:grid-cols-2">
      <div>
        <h2 id="durability-heading" class="font-display text-3xl font-bold text-brand-primary">
          {isZh ? "多撑 3–5 年，综合成本更低" : "Outlasts by 3–5 years, lower total cost"}
        </h2>
        <p class="mt-4 leading-relaxed text-neutral-600">
          {isZh
            ? "KEYVA 的核心差异是耐久性能。在苛刻工况下，我们的金属密封球阀比同行多撑 3–5 年——意味着少换 2–3 次、更少的非计划停机与更低的总拥有成本。"
            : "KEYVA's core difference is durability. In demanding service our metal-seated ball valves outlast competitors by 3–5 years — meaning fewer replacements, less unplanned downtime, and a lower total cost of ownership."}
        </p>
        <a href={localPath(lang, "/contact/")} class="mt-6 inline-block font-semibold text-brand-accent hover:underline">
          {isZh ? "了解 TCO 价值 →" : "Explore TCO value →"}
        </a>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div class="rounded-xl border border-neutral-200 bg-white p-6 text-center shadow-sm">
          <p class="font-display text-4xl font-extrabold text-brand-accent">3–5<span class="text-2xl">y</span></p>
          <p class="mt-2 text-sm text-neutral-500">{isZh ? "比同行多撑" : "longer than peers"}</p>
        </div>
        <div class="rounded-xl border border-neutral-200 bg-white p-6 text-center shadow-sm">
          <p class="font-display text-4xl font-extrabold text-brand-accent">2–3×</p>
          <p class="mt-2 text-sm text-neutral-500">{isZh ? "减少更换次数" : "fewer replacements"}</p>
        </div>
        <div class="rounded-xl border border-neutral-200 bg-white p-6 text-center shadow-sm">
          <p class="font-display text-4xl font-extrabold text-brand-accent">20+</p>
          <p class="mt-2 text-sm text-neutral-500">{isZh ? "项专利" : "patents"}</p>
        </div>
        <div class="rounded-xl border border-neutral-200 bg-white p-6 text-center shadow-sm">
          <p class="font-display text-4xl font-extrabold text-brand-accent">4</p>
          <p class="mt-2 text-sm text-neutral-500">{isZh ? "项国际认证" : "certifications"}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Product preview -->
  <section class="bg-neutral-100 py-16" aria-labelledby="products-heading">
    <div class="container-site">
      <h2 id="products-heading" class="font-display text-3xl font-bold text-brand-primary">{t(lang, "products.title")}</h2>
      <p class="mt-3 max-w-2xl text-neutral-600">{t(lang, "products.subtitle")}</p>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((p) => (
          <a href={localPath(lang, `/products/${p.slug}/`)} class="group overflow-hidden rounded-xl border border-neutral-200 bg-white shadow-sm transition hover:shadow-md">
            <div class="overflow-hidden bg-neutral-50">
              <img
                src={p.data.image}
                alt={isZh ? p.data.nameZh : p.data.nameEn}
                width="1400"
                height="788"
                loading="lazy"
                decoding="async"
                class="aspect-[16/9] w-full object-cover transition duration-500 group-hover:scale-[1.03]"
              />
            </div>
            <div class="p-6">
              <p class="text-xs font-semibold uppercase tracking-wider text-brand-accent">{p.data.series}</p>
              <h3 class="mt-2 font-display text-lg font-semibold text-brand-primary">
                {isZh ? p.data.nameZh : p.data.nameEn}
              </h3>
              <p class="mt-2 text-sm text-neutral-600">{isZh ? p.data.descZh : p.data.descEn}</p>
              {p.data.asmeCertified && (
                <span class="mt-3 inline-block rounded-full bg-brand-primary px-3 py-1 text-xs font-semibold text-white">
                  ASME {isZh ? "认证" : "certified"}
                </span>
              )}
            </div>
          </a>
        ))}
      </div>
      <a href={localPath(lang, "/products/")} class="mt-8 inline-block font-semibold text-brand-accent hover:underline">
        {isZh ? "查看全部产品 →" : "View all products →"}
      </a>
    </div>
  </section>

  <!-- Client logo wall -->
  <section class="py-16" aria-labelledby="clients-heading">
    <div class="container-site text-center">
      <h2 id="clients-heading" class="font-display text-2xl font-bold text-brand-primary">
        {isZh ? "受中国最大能源集团信赖" : "Trusted by China's largest energy groups"}
      </h2>
      <div class="mx-auto mt-8 flex max-w-4xl flex-wrap items-center justify-center gap-3">
        {clientLogos.map((c) => (
          <span class="rounded-lg border border-neutral-200 bg-white px-4 py-2 text-sm font-medium text-neutral-500 shadow-sm">
            {c}
          </span>
        ))}
      </div>
      <p class="mt-6 text-xs text-neutral-400">
        {isZh
          ? "客户 logo 与具体运行数据以书面授权为准。"
          : "Client logos and specific operating data subject to written authorisation."}
      </p>
    </div>
  </section>

  <!-- Certification wall -->
  <section class="bg-neutral-100 py-12" aria-labelledby="certs-heading">
    <div class="container-site flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
      <div class="max-w-xl">
        <h2 id="certs-heading" class="font-display text-2xl font-bold text-brand-primary">
          {isZh ? "认证与许可" : "Certified and licensed"}
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-neutral-600">
          {isZh
            ? "ISO 9001、CE、ASME 锅炉 PCV（2026）与 TS 特种设备许可，构成对外信任基础。"
            : "ISO 9001, CE, ASME boiler PCV (2026) and the TS special-equipment licence form the external trust baseline."}
        </p>
      </div>
      <CertLogos lang={lang} showLabels={false} size="md" />
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-brand-primary py-16 text-white">
    <div class="container-site text-center">
      <h2 class="font-display text-3xl font-bold">
        {isZh ? "直接询价，直达 KEYVA 技术团队" : "Request a quote, direct to KEYVA engineering"}
      </h2>
      <p class="mx-auto mt-4 max-w-prose text-neutral-300">
        {isZh
          ? "结构化在线询盘，按产品系列动态出字段，直进 CRM，不经代理过滤。"
          : "Structured online enquiry with dynamic fields per product series, straight into our CRM — no dealer filtering."}
      </p>
      <a href={localPath(lang, "/contact/")} class="btn-primary mt-8 bg-white text-brand-primary hover:bg-brand-highlight">
        {t(lang, "nav.inquiry")}
      </a>
    </div>
  </section>
</BaseLayout>
