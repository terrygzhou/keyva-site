---
import BaseLayout from "../../layouts/BaseLayout.astro";
import InquiryForm from "../../components/InquiryForm.astro";
import { t, getLangPaths } from "../../i18n/index";

export const getStaticPaths = () =>
  getLangPaths().map(({ lang }) => ({ params: { lang } }));

const { lang } = Astro.params;
const isZh = lang === "zh";

const ossc = [
  { city: isZh ? "纽约" : "New York", detail: isZh ? "总部 · OSSC" : "HQ · OSSC" },
  { city: isZh ? "伯明翰" : "Birmingham", detail: isZh ? "OSSC · 欧洲市场" : "OSSC · Europe" },
  { city: isZh ? "上海" : "Shanghai", detail: isZh ? "OSSC · 智造基地" : "OSSC · Smart manufacturing" },
];
---

<BaseLayout lang={lang} title={isZh ? "联系我们" : "Contact"}
  description={
    isZh
      ? "联系 KEYVA：上海 OSSC 地址、电话、邮箱，以及结构化在线询价表单。"
      : "Contact KEYVA: Shanghai OSSC address, phones, email, and a structured online enquiry form."
  }>
  <section class="bg-neutral-100 py-14">
    <div class="container-site">
      <h1 class="font-display text-4xl font-extrabold text-brand-primary">{t(lang, "contact.title")}</h1>
      <p class="mt-3 max-w-2xl text-lg text-neutral-600">{t(lang, "contact.subtitle")}</p>
      <figure class="mt-8 overflow-hidden rounded-2xl border border-neutral-200 shadow-sm">
        <img
          src="/images/factory/shanghai-ossc.webp"
          alt={isZh ? "OSSC 上海 · 松江智造基地" : "Shanghai OSSC · Songjiang"}
          width="1220"
          height="848"
          loading="lazy"
          decoding="async"
          class="aspect-[21/9] w-full object-cover"
        />
        <figcaption class="bg-white px-4 py-2 text-xs text-neutral-500">
          {isZh
            ? "OSSC 上海 · 上海市松江区申港路 3255 号金地威新智造园 7 栋 1 层"
            : "Shanghai OSSC · 1F, Bldg 7, Jindi Weixing Smart Park, 3255 Shengang Rd, Songjiang, Shanghai"}
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="py-12">
    <div class="container-site grid gap-10 lg:grid-cols-[1fr_1.4fr]">
      <!-- Contact info -->
      <div class="space-y-8">
        <div>
          <h2 class="font-display text-xl font-bold text-brand-primary">{isZh ? "联系信息" : "Contact details"}</h2>
          <dl class="mt-4 space-y-4 text-sm">
            <div>
              <dt class="font-semibold text-neutral-500">{isZh ? "地址（OSSC 上海）" : "Address (Shanghai OSSC)"}</dt>
              <dd class="mt-1 text-neutral-700">
                {isZh
                  ? "上海市松江区申港路 3255 号金地威新智造园 7 栋 1 层"
                  : "1F, Bldg 7, Jindi Weixing Smart Park, 3255 Shengang Rd, Songjiang, Shanghai"}
              </dd>
            </div>
            <div>
              <dt class="font-semibold text-neutral-500">{isZh ? "电子邮箱" : "Email"}</dt>
              <dd class="mt-1 text-neutral-700">
                <a href="mailto:info@keyva.cn" class="text-brand-accent hover:underline">info@keyva.cn</a>
              </dd>
            </div>
            <div>
              <dt class="font-semibold text-neutral-500">{isZh ? "电话" : "Phone"}</dt>
              <dd class="mt-1 space-y-1 text-neutral-700">
                <p>
                  <a href="tel:+86-21-50896336" class="hover:text-brand-accent">
                    {isZh ? "电力咨询：021-50896336" : "Power enquiries: 021-50896336"}
                  </a>
                </p>
                <p>
                  <a href="tel:+86-21-50898122" class="hover:text-brand-accent">
                    {isZh ? "石化/矿山咨询：021-50898122" : "Petrochemical / Mining: 021-50898122"}
                  </a>
                </p>
              </dd>
            </div>
          </dl>
        </div>

        <!-- OSSC locations -->
        <div>
          <h2 class="font-display text-xl font-bold text-brand-primary">{isZh ? "三大 OSSC" : "OSSC locations"}</h2>
          <ul class="mt-4 space-y-3">
            {ossc.map((o) => (
              <li class="rounded-lg border border-neutral-200 bg-white p-4 shadow-sm">
                <p class="font-display font-semibold text-brand-primary">{o.city}</p>
                <p class="text-sm text-neutral-500">{o.detail}</p>
              </li>
            ))}
          </ul>
          <p class="mt-4 text-xs text-neutral-500">
            {isZh
              ? "直销为主：直接询价直达 KEYVA 技术团队，弱化经代理路径。"
              : "Direct-sales first: enquiries reach KEYVA engineering directly, no dealer filtering."}
          </p>
        </div>
      </div>

      <!-- Structured inquiry form (replaces 4 DOCX downloads) -->
      <div>
        <InquiryForm lang={lang} />
      </div>
    </div>
  </section>
</BaseLayout>
