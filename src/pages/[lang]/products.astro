---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { t, localPath, getLangPaths } from "../../i18n/index";
import { getCollection } from "astro:content";

// Manual [lang] routes: fan out one entry per configured locale so both /zh/
// and /en/ are built. Astro.params.lang carries the active locale.
export const getStaticPaths = () =>
  getLangPaths().map(({ lang }) => ({ params: { lang } }));

const { lang } = Astro.params;
const isZh = lang === "zh";

const products = await getCollection("products");
---

<BaseLayout lang={lang} title={isZh ? "产品中心" : "Products"}
  description={
    isZh
      ? "KEYVA 产品中心：7 个系列方孔/圆孔金属密封球阀，ASTM/ASME 标准，150Lb–4500Lb。"
      : "KEYVA products: 7 series of square/round-bore metal-seated ball valves, ASTM/ASME, 150–4500 Lb."
  }>
  <section class="bg-neutral-100 py-14">
    <div class="container-site">
      <h1 class="font-display text-4xl font-extrabold text-brand-primary">{t(lang, "products.title")}</h1>
      <p class="mt-3 max-w-2xl text-lg text-neutral-600">{t(lang, "products.subtitle")}</p>
      <p class="mt-3 text-sm font-semibold text-neutral-500">{t(lang, "products.std")}</p>
    </div>
  </section>

  <section class="py-12">
    <div class="container-site space-y-12">
      {products.map((p) => (
        <article class="grid gap-6 rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm md:grid-cols-[1fr_2fr] md:p-8">
          {/* Series card */}
          <div class="flex flex-col justify-center overflow-hidden rounded-xl bg-neutral-100 p-5">
            <img
              src={p.data.image}
              alt={isZh ? p.data.nameZh : p.data.nameEn}
              width="1400"
              height="788"
              loading="lazy"
              decoding="async"
              class="mb-5 aspect-[16/9] w-full rounded-lg object-cover shadow-sm"
            />
            <p class="text-sm font-semibold uppercase tracking-wider text-brand-accent">{p.data.series}</p>
            <h2 class="mt-1 font-display text-xl font-bold text-brand-primary">
              {isZh ? p.data.nameZh : p.data.nameEn}
            </h2>
            <p class="mt-2 text-sm text-neutral-600">{isZh ? p.data.descZh : p.data.descEn}</p>
            <dl class="mt-4 space-y-2 text-sm">
              <div>
                <dt class="font-semibold text-neutral-500">{isZh ? "规格" : "Size"}</dt>
                <dd class="text-neutral-700">{p.data.size}</dd>
              </div>
              <div>
                <dt class="font-semibold text-neutral-500">{isZh ? "材料" : "Materials"}</dt>
                <dd class="text-neutral-700">{p.data.materials.join(" / ")}</dd>
              </div>
              <div>
                <dt class="font-semibold text-neutral-500">{isZh ? "连接" : "Connection"}</dt>
                <dd class="text-neutral-700">{p.data.connection}</dd>
              </div>
            </dl>
            {p.data.asmeCertified && (
              <span class="mt-4 inline-block w-fit rounded-full bg-brand-primary px-3 py-1 text-xs font-semibold text-white">
                {isZh ? "ASME 认证（2026）" : "ASME certified (2026)"}
              </span>
            )}
            <a href={localPath(lang, `/products/${p.slug}/`)} class="btn-outline mt-6 self-start">
              {isZh ? "查看详情 →" : "Details →"}
            </a>
          </div>

          {/* Features + apps */}
          <div class="grid gap-6 lg:grid-cols-2">
            <div>
              <h3 class="font-display text-base font-semibold text-brand-primary">
                {isZh ? "技术特点" : "Technical features"}
              </h3>
              <ul class="mt-3 list-inside list-disc space-y-1.5 text-sm text-neutral-700">
                {(isZh ? p.data.featuresZh : p.data.featuresEn).map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
            </div>
            <div>
              <h3 class="font-display text-base font-semibold text-brand-primary">
                {isZh ? "应用场景" : "Applications"}
              </h3>
              <ul class="mt-3 list-inside list-disc space-y-1.5 text-sm text-neutral-700">
                {(isZh ? p.data.appsZh : p.data.appsEn).map((a) => (
                  <li>{a}</li>
                ))}
              </ul>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- PCV system explainer -->
  {products.some((p) => p.data.isPCV) && (
    <section class="bg-neutral-100 py-14">
      <div class="container-site">
        <h2 class="font-display text-2xl font-bold text-brand-primary">
          {isZh ? "PCV 动力泄放阀系统" : "PCV power-actuated relief system"}
        </h2>
        <p class="mt-4 max-w-3xl leading-relaxed text-neutral-600">
          {isZh
            ? "火力发电厂锅炉或过热器为超压保护设计配置压力释放阀（安全阀）和动力泄放阀（PCV/PaRV）。一个稳定可靠的压力控制系统可在压力不断变化时快速稳定系统压力，同时防止主安全阀频跳、延长其使用寿命。主安全阀起跳即算事故。"
            : "Fossil boilers/superheaters use a pressure-relief valve (safety valve) plus a power-actuated control valve (PCV/PaRV) for over-pressure protection. A stable control system quickly stabilises pressure under changing load, prevents safety-valve chattering and extends its life. A main safety-valve lift is treated as an incident."}
        </p>
        <ol class="mt-6 grid max-w-3xl gap-2 sm:grid-cols-2">
          {(isZh
            ? ["主阀", "隔离阀（手动或电动）", "压力变送器 + 仪表阀组", "虹吸管", "就地控制箱", "DCS 远程控制箱", "接水盘"]
            : ["Main valve", "Isolation valve (manual or electric)", "Pressure transmitter + instrument valve group", "Siphon pipe", "Local control box", "DCS remote control box", "Water catch pan"]
          ).map((item, i) => (
            <li class="flex items-center gap-2 text-sm text-neutral-700">
              <span class="flex h-6 w-6 items-center justify-center rounded-full bg-brand-primary text-xs font-bold text-white">{i + 1}</span>
              {item}
            </li>
          ))}
        </ol>
        <p class="mt-6 max-w-3xl rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800">
          {isZh
            ? "动力泄放阀需 ASME 认证。总排放量应在锅炉或过热器最大连续蒸发量（BMCR）的 10%–30% 之间。"
            : "The PCV requires ASME certification. Total relieving capacity should fall within 10%–30% of the boiler/superheater BMCR."}
        </p>
      </div>
    </section>
  )}
</BaseLayout>
