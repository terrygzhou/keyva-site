---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const studies = (await getCollection("case-studies"))
  .filter((c) => !c.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Case Studies" description="How KeyVA turns complexity into measurable outcomes — real projects, real results.">
  <section class="py-16">
    <div class="container-site">
      <h1 class="font-display text-4xl font-bold text-brand-primary">Case studies</h1>
      <p class="mt-4 max-w-prose text-lg text-neutral-600">
        Anonymised, but honest. Here's what transformation looks like in practice.
      </p>

      <div class="mt-12 grid gap-8 md:grid-cols-2">
        {studies.map((c) => (
          <article class="rounded-xl border border-neutral-200 bg-white p-8 shadow-sm">
            <p class="text-sm font-semibold uppercase tracking-wider text-brand-accent">
              {c.data.industry}
            </p>
            <h2 class="mt-2 font-display text-xl font-semibold text-brand-primary">
              <a href={`/case-studies/${c.slug}/`} class="hover:text-brand-accent">{c.data.title}</a>
            </h2>
            <p class="mt-3 text-neutral-600">{c.data.summary}</p>
            {c.data.results.length > 0 && (
              <ul class="mt-4 space-y-1 text-sm text-neutral-500">
                {c.data.results.slice(0, 2).map((r) => (
                  <li>&mdash; {r}</li>
                ))}
              </ul>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
