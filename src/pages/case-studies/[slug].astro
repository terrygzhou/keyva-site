---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const studies = await getCollection("case-studies");
  return studies.map((c) => ({ params: { slug: c.slug } }));
}
const { slug } = Astro.params;
const study = (await getCollection("case-studies")).find((c) => c.slug === slug);

if (!study) {
  // Unreachable: every generated path comes from the collection.
  throw new Error(`Unknown case study slug: ${slug}`);
}

const d = study.data;
---

<BaseLayout title={d.title} description={d.summary}>
  <article class="py-16">
    <div class="container-site max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-accent">{d.industry}</p>
      <h1 class="mt-2 font-display text-4xl font-bold text-brand-primary">{d.title}</h1>
      <p class="mt-4 text-lg text-neutral-600">{d.summary}</p>

      <h2 class="mt-10 text-xl font-semibold text-brand-primary">Challenge</h2>
      <p class="mt-2 text-neutral-700">{d.challenge}</p>

      <h2 class="mt-8 text-xl font-semibold text-brand-primary">Approach</h2>
      <p class="mt-2 text-neutral-700">{d.approach}</p>

      <h2 class="mt-8 text-xl font-semibold text-brand-primary">Results</h2>
      <ul class="mt-3 space-y-2 text-neutral-700">
        {d.results.map((r) => (
          <li class="flex items-start gap-2">
            <span aria-hidden="true" class="mt-1 h-2 w-2 rounded-full bg-brand-accent" /> {r}
          </li>
        ))}
      </ul>

      {d.tags.length > 0 && (
        <div class="mt-10 flex flex-wrap gap-2">
          {d.tags.map((t) => (
            <span class="rounded-full bg-neutral-100 px-3 py-1 text-xs font-medium text-neutral-600">{t}</span>
          ))}
        </div>
      )}

      <div class="mt-12 rounded-xl bg-neutral-100 p-8">
        <h2 class="text-xl font-semibold text-brand-primary">Facing a similar challenge?</h2>
        <a href="/contact/" class="btn-primary mt-4">Talk to us</a>
      </div>
    </div>
  </article>
</BaseLayout>
